  "filterSpec": {
    "sizeClass": {
      "type": "single",
      "values": [
        "any",
        "compact",
        "medium",
        "large"
      ],
      "rule": "最大辺が160mm以下=compact; 160mm超230mm以下=medium; 230mm超=large。独自分類であり公称サイズ名ではない"
    },
    "pageBand": {
      "type": "single",
      "values": [
        "any",
        "1-20",
        "21-40"
      ],
      "rule": "各商品の代表バリエーションの正確なページ数に適用。範囲内の全ページ数に注文対応する意味ではない"
    },
    "coverCategory": {
      "values": [
        "any",
        "hard",
        "soft",
        "flat_pasted",
        "unknown"
      ],
      "rule": "合紙フラット・不明をハード/ソフトと断定しない"
    },
    "smartphoneEditing": {
      "values": [
        "any",
        "must_yes"
      ],
      "rule": "must_yesではyesのみ掲載。unknownは表示しないか要確認として別枠にする"
    },
    "maxBudgetJpy": {
      "type": "integer_or_null",
      "rule": "送料込み比較例の金額に対してのみ適用。商品代金のみの予算とは区別する"
    },
    "sort": {
      "values": [
        "exampleTotalJpyTaxIncluded_asc",
        "bookPriceJpyTaxIncluded_asc"
      ],
      "default": "exampleTotalJpyTaxIncluded_asc"
    }
  },
  "pricingAssumptions": {
    "quantity": 1,
    "tax": "included",
    "discounts": "none",
    "payment": "credit_card_where_relevant",
    "destination": "Japan domestic; remote-area surcharges not modeled",
    "delivery": "商品別に公式確認できた配送方法を1つ指定。配送方法は商品ごとに異なり、必ずしも最安ではない",
    "formula": "exampleTotalJpyTaxIncluded = bookPriceJpyTaxIncluded + shippingJpyTaxIncluded",
    "pricingNote": "表示する送料込み額は、指定した配送方法で1冊注文する場合の比較例。全商品に共通する配送速度や郵送手段ではない。"
  },
  "decisions": {
    "scope": "6社・16商品バリエーション（6/16/20/22/24ページなど。全ページ数全サイズ対応を主張しない）",
    "officialLinks": "商品個別ページを案内。アフィリンクは未設定",
    "unknownHandling": "スマホ対応やカバー種別が未確認ならunknownのまま。料金の未確認追加バリエーションは出さない。",
    "noPriceEstimates": "ページ数の追加料金やサイズ変更を計算式で推測しない。商品価格はすべて公式掲載値",
    "seo": "誇大な「最安」「おすすめ」ランキングを避け、データの確認日を表示"
  },
  "knownLimitations": [
    "サイトは全商品・全ページ数の比較ではない。掲載16バリエーションのみ。",
    "各社のサイズ・ページ数・印刷方式・合紙製本・仕上がり品質は異なり、送料込み順が同等品質での安さを示すわけではない。",
